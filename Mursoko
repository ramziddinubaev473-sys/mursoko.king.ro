const cards=document.getElementById('teamCards'),bio=document.getElementById('bio');people.forEach((p,i)=>{const b=document.createElement('button');b.type='button';b.className='person'+(i===0?' active':'');b.innerHTML=`<div class="portrait"><img src="${p.image}" alt="Иллюстративный портрет персонажа ${p.name}" loading="lazy"><span class="avatar">${p.initials}</span></div><div class="person-body"><h3>${p.name}</h3><span class="role">${p.role}</span><p>${p.short}</p></div>`;b.addEventListener('click',()=>{document.querySelectorAll('.person').forEach(x=>x.classList.remove('active'));b.classList.add('active');bio.innerHTML='<span class=\"bio-label\">ПОЛНОЕ ДОСЬЕ / '+p.initials+'</span><span class=\"bio-copy\">'+p.bio+'</span>'});cards.appendChild(b)});bio.innerHTML='<span class=\"bio-label\">ПОЛНОЕ ДОСЬЕ / '+people[0].initials+'</span><span class=\"bio-copy\">'+people[0].bio+'</span>';document.querySelectorAll('.section,.project,.update').forEach(el=>el.classList.add('reveal'));const io=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
document.querySelector('.menu').addEventListener('click',()=>document.querySelector('.nav').classList.toggle('open'));document.querySelectorAll('.nav a').forEach(a=>a.addEventListener('click',()=>document.querySelector('.nav').classList.remove('open')));
</script></body></html>

